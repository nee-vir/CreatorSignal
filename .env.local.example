# ==============================================================================
# CREATOR SIGNAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your actual credentials.
# NEVER commit .env.local to version control or share secret keys publicly.
# ==============================================================================

# Application Base URL (Used for redirects and webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration (Database & Authentication)
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Optional secret for triggering the midnight credit reset web-cron
CRON_SECRET=your_secret_cron_token_here

# ------------------------------------------------------------------------------
# YouTube Data API v3
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=your_google_cloud_youtube_api_key

# ------------------------------------------------------------------------------
# AI Generator (Angle Pivot Hooks)
# Obtain from: Google AI Studio (https://aistudio.google.com/)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Dual Subscription Tiers)
# Obtain from: Razorpay Dashboard -> Settings -> API Keys & Webhooks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Plan IDs:
# 1. Creator Tier: ₹199/month recurring plan (50 daily credits)
RAZORPAY_PLAN_ID_CREATOR=plan_your_199_plan_id

# 2. Pro Tier: ₹299/month recurring plan (100 daily credits + Bulk CSV Export)
RAZORPAY_PLAN_ID_PRO=plan_your_299_plan_id
